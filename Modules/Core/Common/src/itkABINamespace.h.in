#ifndef itkABINamespace_h
#define itkABINamespace_h

#cmakedefine01 ITK_HAS_ABI_NAMESPACE

#if !defined(ITK_NO_ABI_NAMESPACE) && ITK_HAS_ABI_NAMESPACE

// ITK_ABI_NAMESPACE_NAME is restricted to [a-zA-Z0-9_]+ at configure time, so
// it is safe to paste into an identifier by ITK_ABI_NAMESPACE_MANGLE, which
// mangles C symbols exported from ITK (e.g. extern "C" { void some_func(); }).
#  define ITK_ABI_NAMESPACE_NAME @ITK_ABI_NAMESPACE_NAME@
#  define ITK_ABI_NAMESPACE_MANGLE(x) @ITK_ABI_NAMESPACE_NAME@_##x

#  if defined(__cplusplus)
#    define ITK_ABI_NAMESPACE_BEGIN @ITK_ABI_NAMESPACE_BEGIN@
#    define ITK_ABI_NAMESPACE_END @ITK_ABI_NAMESPACE_END@
#  else
#    define ITK_ABI_NAMESPACE_BEGIN
#    define ITK_ABI_NAMESPACE_END
#  endif

#else

#  define ITK_ABI_NAMESPACE_MANGLE(x) x
#  define ITK_ABI_NAMESPACE_BEGIN
#  define ITK_ABI_NAMESPACE_END

#endif

#endif // itkABINamespace_h
